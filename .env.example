# Copy to .env for local development. Never commit .env.

# Local development: True. Production: False.
DEBUG=True

# Any long random string. Required when DEBUG is False.
SECRET_KEY=change-me

ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated, include scheme, e.g. https://oppscout.onrender.com
CSRF_TRUSTED_ORIGINS=

# Leave commented out locally to use SQLite (db.sqlite3).
# Production: the Neon connection string, with ?sslmode=require
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# AI provider. Keep the key out of chat, git and screenshots.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Caps, kept below the free tier (15/min, 500/day):
# AI_VISITOR_HOURLY_CAP=6
# AI_MINUTE_CAP=12
# AI_DAILY_CAP=400
